{
  "name": "dsh-popup-notify",
  "version": "0.1.4",
  "description": "通过 Windows 原生模态弹窗为 DeepSeek Harness 提醒审批请求、提问与计划审阅、回合结束；零依赖，无预编译二进制。",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.mjs",
  "exports": {
    ".": "./lib/index.mjs",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "deepseek-harness",
    "notifications",
    "notification",
    "desktop-notification",
    "popup",
    "messagebox",
    "windows",
    "approval",
    "plan-review",
    "ask-user-question"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yiumanlenong/dsh-popup-notify.git"
  },
  "homepage": "https://github.com/yiumanlenong/dsh-popup-notify#readme",
  "bugs": {
    "url": "https://github.com/yiumanlenong/dsh-popup-notify/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test tests/plugin.test.mjs tests/display-metadata.test.mjs",
    "pack:check": "npm pack --dry-run"
  }
}
