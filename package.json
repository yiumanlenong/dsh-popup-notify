{
  "name": "dsh-popup-notify",
  "version": "0.1.2",
  "description": "Modal desktop popups for DeepSeek Harness: approval requests, questions/plan reviews, and turn completion. Zero dependencies, no bundled binaries.",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.mjs",
  "exports": {
    ".": "./lib/index.mjs"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "deepseek-harness",
    "notifications",
    "notification",
    "desktop-notification",
    "popup",
    "messagebox",
    "windows",
    "approval",
    "plan-review",
    "ask-user-question"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yiumanlenong/dsh-popup-notify.git"
  },
  "homepage": "https://github.com/yiumanlenong/dsh-popup-notify#readme",
  "bugs": {
    "url": "https://github.com/yiumanlenong/dsh-popup-notify/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test tests/plugin.test.mjs"
  }
}
